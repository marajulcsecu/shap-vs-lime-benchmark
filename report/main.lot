\addvspace {10\p@ }
\contentsline {table}{\numberline {3.1}{\ignorespaces Benchmark datasets. `Positive' is the prevalence of the positive class; `Missing' is the fraction of missing cells after the dataset-specific semantics fixes of Section~\ref {sec:method-data}.}}{14}{table.caption.6}%
\contentsline {table}{\numberline {3.2}{\ignorespaces Hyperparameter search spaces and SHAP backend assignment. Grids are capped at 12 combinations to fit the compute budget.}}{17}{table.caption.8}%
