\contentsline {table}{\numberline {4.1}{\ignorespaces Predictive performance, nested cross-validation (5 outer $\times $ 3 inner folds), mean $\pm $ standard deviation over the outer folds. Four representative metrics; all eight, for every cell, are in \texttt {results/performance.csv} and in the extended report.}}{20}{table.caption.9}%
\contentsline {table}{\numberline {4.2}{\ignorespaces RQ1 --- agreement between SHAP and LIME feature rankings, per instance. Medians with 95\% percentile bootstrap intervals. Kendall $\tau _b$, Jaccard@3, and floor-normalised RBO are in \texttt {results/metrics\_agreement.csv} and in the extended report.}}{22}{table.caption.11}%
\contentsline {table}{\numberline {4.3}{\ignorespaces RQ2 --- explanation stability decomposed into three sources: explainer randomness (re-run), input perturbation (Lipschitz), and model retraining. Medians over all cells.}}{22}{table.caption.15}%
\contentsline {table}{\numberline {4.4}{\ignorespaces RQ3 --- fidelity to the model's decision function, median baseline. Medians with 95\% bootstrap intervals across all 18 cells.}}{22}{table.caption.19}%
\contentsline {table}{\numberline {4.5}{\ignorespaces RQ4 --- cost per explanation and the fidelity it buys. Single-threaded, identical hardware for every measurement.}}{24}{table.caption.21}%
\contentsline {table}{\numberline {4.6}{\ignorespaces RQ5 --- pre-registered plausibility reference sets and top-5 overlap.}}{25}{table.caption.23}%
\contentsline {table}{\numberline {4.7}{\ignorespaces RQ6 --- does rank fusion beat the \emph {better} of SHAP and LIME? Tested on evaluation instances only; the fidelity weight was fitted on a disjoint calibration split. Effect sizes and unadjusted $p$ are in \texttt {results/stats\_hypotheses.csv} and in the extended report.}}{28}{table.caption.25}%
